{
  "_comment": "Configuration file for kernel-review-agent",
  "_comment2": "System-wide: /etc/kernel-review-agent/config.json",
  "_comment3": "User-specific: ~/.config/kernel-review-agent/config.json",
  "_comment4": "User config overrides system config",

  "DEFAULT_HOST": "localhost",
  "DEFAULT_PORT": 8080,
  "DEFAULT_API_KEY": "dummy",
  "DEFAULT_MODEL": "gpt-4",

  "DEFAULT_MAX_TOKENS": 16000,

  "CATEGORIZE_MAX_TOKENS": 8000,
  "ANALYZE_MAX_TOKENS": 16000,
  "VERIFY_MAX_TOKENS": 16000,

  "TRUNCATION_WARNING_THRESHOLD": 0.95,

  "MAX_RETRIES": 1,
  "RETRY_DELAY": 1.0,
  "RETRY_BACKOFF": 2.0,

  "LLM_TIMEOUT": 300,
  "CONNECT_TIMEOUT": 10,

  "_comment_host_reset": "Host reset: auto-recover from fatal LLM connection errors (0 = unlimited retries)",
  "ENABLE_HOST_RESET": false,
  "HOST_RESET_FALLBACK_MODEL": null,
  "HOST_RESET_MAX_ATTEMPTS": 0,

  "DEFAULT_OUTPUT_DIR": ".",
  "DEBUG_DUMP_DIR": "debug_dumps",

  "_comment_upstream_review": "Upstream review mode: enable commit message quality, Fixes: tag detection/validation, and subjective checks (default: false)",
  "UPSTREAM_REVIEW": false,

  "_comment_repos": "Backport verification: path to upstream Linux kernel and optional intermediate patch repository",
  "PATCH_REPO": null,
  "UPSTREAM_REPO": null,

  "_comment_compat": "Deprecated aliases for PATCH_REPO and UPSTREAM_REPO (still accepted for backward compatibility)",
  "SUSE_KERNEL_SOURCE_REPO": null,
  "UPSTREAM_LINUX_REPO": null
}
